PORT=3000
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=/api

# Option A — Standard PostgreSQL or Supabase connection URL (local / Supabase / Neon / Render)
# For Supabase, use the Transaction Pooler URL for DATABASE_URL and Direct Connection URL for DIRECT_URL (migrations).
DATABASE_URL=
DIRECT_URL=

# Option B — Cloud SQL discrete variables (auto-provided in AI Studio Cloud SQL environments)
# SQL_HOST=
# SQL_DB_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=

# Optional — Enable Google Sign-In via Firebase Auth (leave blank to use email/password auth only)
# FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# AI Task Decomposer (server-side Gemini API key — never expose to client)
GEMINI_API_KEY=
